<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">
  <Package Name="Minecraft Server Downloader"
           Manufacturer="Minecraft-1314"
           Version="$(var.ProductVersion)"
           UpgradeCode="{7A3BB87B-7B8F-41BE-96D2-7FCB24C70F9B}"
           Scope="perMachine">
    <MajorUpgrade DowngradeErrorMessage="A newer version of Minecraft Server Downloader is already installed." />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />
    <Icon Id="AppIcon" SourceFile="$(var.AppSource)\app.ico" />
    <Property Id="ARPPRODUCTICON" Value="AppIcon" />
    <Property Id="ARPDESCRIPTION" Value="Minecraft Server Downloader" />
    <Feature Id="MainFeature" Title="Minecraft Server Downloader" Level="1">
      <ComponentGroupRef Id="ApplicationFiles" />
      <ComponentRef Id="StartMenuShortcut" />
    </Feature>
    <ui:WixUI Id="WixUI_Minimal" />
  </Package>

  <Fragment>
    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="MinecraftServerDownloader" />
    </StandardDirectory>
  </Fragment>

  <Fragment>
    <ComponentGroup Id="ApplicationFiles" Directory="INSTALLFOLDER">
      <Files Include="$(var.AppSource)\**" />
    </ComponentGroup>
  </Fragment>

  <Fragment>
    <StandardDirectory Id="ProgramMenuFolder">
      <Component Id="StartMenuShortcut" Guid="{F15DB30E-18EC-48D3-8D20-46D49B0C1E69}">
        <Shortcut Id="StartMenuShortcutLink"
                  Name="Minecraft Server Downloader"
                  Target="[INSTALLFOLDER]MinecraftServerDownloader.exe"
                  WorkingDirectory="INSTALLFOLDER"
                  Icon="AppIcon"
                  IconIndex="0" />
        <RemoveFolder Id="RemoveStartMenuFolder" On="uninstall" />
        <RegistryValue Root="HKCU"
                       Key="Software\MinecraftServerDownloader\Shortcuts"
                       Name="StartMenu"
                       Type="string"
                       Value="[INSTALLFOLDER]"
                       KeyPath="yes" />
      </Component>
    </StandardDirectory>
  </Fragment>
</Wix>
